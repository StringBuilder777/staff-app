{
  "name": "staff-app-edge-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase Edge Functions and local tooling for Staff App",
  "scripts": {
    "serve:local": "npx -p tsx tsx --tsconfig supabase/functions/tsconfig.json supabase/functions/serve_local.ts",
    "tunnel:cf": "cloudflared tunnel --url http://localhost:54321",
    "tunnel": "npx localtunnel --port 54321",
    "test": "npx -p tsx tsx --tsconfig supabase/functions/tsconfig.json supabase/functions/tests/staff_edge_functions_test.ts",
    "check": "npx -p typescript tsc --project supabase/functions/tsconfig.json",
    "deploy": "npx supabase functions deploy --project-ref uopfoekxkluotowilzaa"
  }
}
